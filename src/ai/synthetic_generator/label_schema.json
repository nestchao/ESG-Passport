{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic document intended labels",
  "type": "object",
  "required": [
    "version",
    "item_id",
    "base_document_id",
    "category",
    "layout_family",
    "split",
    "width",
    "height",
    "language",
    "period",
    "intended_lines",
    "expected_fields",
    "transforms",
    "source_real_pixels_used",
    "human_visibility_review",
    "label_status",
    "supporting_fields",
    "arithmetic_checks",
    "not_official"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "base_document_id": {
      "type": "string"
    },
    "layout_family": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "label_status": {
      "type": "string"
    },
    "not_official": {
      "type": "string"
    },
    "augmentation_revision": {
      "type": "string"
    },
    "category": {
      "enum": [
        "electricity",
        "water",
        "fuel",
        "waste"
      ]
    },
    "split": {
      "enum": [
        "development",
        "validation_candidate",
        "test_candidate"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "source_real_pixels_used": {
      "const": false
    },
    "human_visibility_review": {
      "enum": [
        "pending",
        "passed",
        "failed"
      ]
    },
    "intended_lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "line_id",
          "text",
          "bbox",
          "polygon",
          "source_bbox"
        ],
        "properties": {
          "line_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "source_bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "polygon": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "additionalProperties": false
      }
    },
    "expected_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "transforms": {
      "type": "object",
      "required": [
        "seed",
        "profile",
        "forward_homography",
        "sharpness_factor"
      ],
      "properties": {
        "seed": {
          "type": "integer"
        },
        "profile": {
          "enum": [
            "clean",
            "scan",
            "photo"
          ]
        },
        "sharpness_factor": {
          "const": 1.0
        },
        "forward_homography": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "supporting_fields": {
      "type": "object"
    },
    "arithmetic_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "equation",
          "lhs",
          "rhs"
        ],
        "properties": {
          "equation": {
            "type": "string"
          },
          "lhs": {
            "type": [
              "string",
              "number"
            ]
          },
          "rhs": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "field",
        "value",
        "unit",
        "role",
        "period",
        "evidence",
        "temporal_semantics"
      ],
      "properties": {
        "field": {
          "enum": [
            "purchased_electricity",
            "electricity_previous_reading",
            "electricity_current_reading",
            "maximum_demand",
            "water_consumption",
            "water_previous_reading",
            "water_current_reading",
            "reading_type",
            "petrol_consumption",
            "diesel_consumption",
            "fuel_unit_price",
            "fuel_amount",
            "rounded_total",
            "cash_paid",
            "change",
            "amount_due",
            "gross_weight",
            "tare_weight",
            "waste_transferred",
            "waste_unit_price",
            "waste_charge",
            "declared_destination"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "kWh",
            "kW",
            "m3",
            "L",
            "kg",
            "t",
            "MYR",
            "MYR/L",
            "MYR/t",
            null
          ]
        },
        "role": {
          "enum": [
            "activity",
            "context"
          ]
        },
        "period": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "end": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "line_id",
              "text"
            ],
            "properties": {
              "line_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "temporal_semantics": {
          "enum": [
            "unscoped_context",
            "point_date",
            "service_period_context"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
