# Copy to .env in this project root only if it does not already exist.
# Fill locally. Never commit credentials; only NEXT_PUBLIC_API_URL is browser-facing.

# Backend-only Supabase settings.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVER_KEY=
SUPABASE_STORAGE_BUCKET=esg-evidence
FRONTEND_ORIGIN=http://127.0.0.1:3000
ALLOW_SAMPLE_RESET=false
# Optional browser-access probes run by the backend CLI.
SUPABASE_PUBLISHABLE_KEY=

# Public frontend setting.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# Server-only Google AI Studio configuration.
GEMINI_API_KEY=
# Set to free only after confirming the Google project billing status.
GOOGLE_API_BILLING_TIER=unconfirmed

# Optional server-only Grafilab API configuration.
GRAFILAB_API_KEY=
GRAFILAB_BASE_URL=https://llm.grafilab.ai/v1
