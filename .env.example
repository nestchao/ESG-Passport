# Copy this file to .env in this project root. Keep .env private and out of Git.
# Backend-only Supabase settings. Fill with values from your own project.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVER_KEY=
SUPABASE_STORAGE_BUCKET=esg-evidence
FRONTEND_ORIGIN=http://127.0.0.1:3000
ALLOW_SAMPLE_RESET=false
# Optional: browser access probes run by the backend CLI.
SUPABASE_PUBLISHABLE_KEY=

# Public frontend setting. This is the only root-file value exported to the browser.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# Optional hosted demo protection. Keep false for the existing local direct API.
# Render must enable this on both services. Set hosted values in Render, not here.
DEMO_ACCESS_ENABLED=false
# Backend and frontend server: same random value, at least 32 characters.
BACKEND_SHARED_KEY=
# Frontend server only: password >=16 characters; signing secret >=32 characters.
DEMO_PASSWORD=
DEMO_SESSION_SECRET=
# Frontend server only: backend HTTPS Render URL, without /api/backend.
BACKEND_INTERNAL_URL=
# Optional frontend server override for a custom HTTPS domain; Render provides RENDER_EXTERNAL_URL automatically.
DEMO_PUBLIC_ORIGIN=
