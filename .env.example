# Copy this file to .env in this project root. Keep .env private and out of Git.
# Backend-only Supabase settings. Fill with values from your own project.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVER_KEY=
SUPABASE_STORAGE_BUCKET=esg-evidence
FRONTEND_ORIGIN=http://127.0.0.1:3000
ALLOW_SAMPLE_RESET=false
# Optional: browser access probes run by the backend CLI.
SUPABASE_PUBLISHABLE_KEY=

# Public frontend setting. This is the only root-file value exported to the browser.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
