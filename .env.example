# Server only. Copy to .env in the repository root (or use src/backend/.env) (or load these values in your server environment).
# Never place these values in src/frontend, a VITE_* variable, a screenshot or a commit.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVER_KEY=
SUPABASE_STORAGE_BUCKET=esg-evidence
FRONTEND_ORIGIN=http://127.0.0.1:3000
ALLOW_SAMPLE_RESET=false
# Optional browser publishable/legacy anon key used only by `check --anon-key`.
SUPABASE_PUBLISHABLE_KEY=
